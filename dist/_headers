# Cloudflare Pages / Netlify response headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Pages: always check for a newer version (fast, uses ETag)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Images and icons rarely change: keep 30 days, refresh in the background
/posters/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/illustrations/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/qr/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/favicon.*
  Cache-Control: public, max-age=2592000

# Scripts, styles and data: 1 hour, refresh in the background
/*.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/*.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/*.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/guides/*.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
